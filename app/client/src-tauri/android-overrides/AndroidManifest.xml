<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Só para ler o QR code de convite (EscanearQrScreen); a permissão é pedida ao abrir essa tela, não na instalação. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Biometria para abrir o Cofre com a senha guardada no Keystore (CofreSenhaBridge). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Avisos do Ecos (push por UnifiedPush, EcosPushReceiver.kt); no Android 13+ é pedida ao ligar os avisos. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+: para enxergar os distribuidores UnifiedPush instalados (ntfy etc.). -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ecos_client"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Recebe do distribuidor UnifiedPush o endereço deste aparelho e os avisos do servidor. -->
        <receiver android:name=".EcosPushReceiver" android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            </intent-filter>
        </receiver>
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Menu "Compartilhar" do Android: imagens viram anexo de uma nota nova (CompartilharBridge.kt) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Segundo destino do menu "Compartilhar": "Ecos Cofre". Mesma Activity; a ponte reconhece o alias pelo nome
             (CompartilharBridge.DESTINO_COFRE) e manda o arquivo para os comprovantes do Cofre, não para uma nota. -->
        <activity-alias
            android:name=".CompartilharCofre"
            android:targetActivity=".MainActivity"
            android:label="Ecos Cofre"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
