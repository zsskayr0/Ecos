# Copie para `.env` e ajuste. Nenhuma dessas variáveis tem valor sensível
# de fábrica — segredos ausentes são gerados automaticamente no primeiro
# boot (seção 5.4) e nunca versionados.

# --- Geral ---
# `local` só em desenvolvimento (build na própria máquina). Em produção, fixe a versão do release:
# ECOS_VERSION=0.10.0-alpha e ECOS_REGISTRY=ghcr.io/zsskayr0, depois `docker compose pull && docker compose up -d`.
ECOS_VERSION=local
# ECOS_REGISTRY=ghcr.io/zsskayr0
ECOS_ENV=production

# --- ecos-app ---
# Pasta raiz do vault de arquivos (seção 1.5) — bind mount real do host.
ECOS_NOTES_PATH=../ecos-notes
# Deixe vazio para o app gerar e persistir sozinho `segredo-sessao` FORA da pasta de notas (seção 5.4):
# no Docker, ao lado do índice (volume ecos-index), então copiar o backup das notas não leva o segredo.
# ECOS_SECRETS_DIR=  # opcional: outra pasta para os segredos (sessão, chave do calendário)
ECOS_SESSION_SECRET=

# --- Cofre (opcional, seção 0.3) ---
# true só depois de rodar `docker compose --profile vault up -d` (README
# de ativação, seção 12).
ECOS_VAULT_ENABLED=false

# --- Staging (só se for rodar docker-compose.staging.yml) ---
ECOS_NOTES_PATH_STAGING=./data/notes-staging

# --- Google Calendar (sincronização bidirecional de eventos) ---
# Credencial OAuth do tipo "App para computador" criada no Google Cloud Console.
# Sem estas duas variáveis a integração fica desligada. Nunca versione o secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Intervalo do sync em segundos (mínimo 60).
# ECOS_CALENDARIO_INTERVAL_SECS=300
# Envia ao Google logo depois de criar/editar/apagar um evento (padrão: true).
# ECOS_CALENDARIO_ENVIO_IMEDIATO=true
